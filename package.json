{
  "name": "markdown-note",
  "productName": "简记",
  "version": "1.2.0",
  "description": "简洁的桌面 Markdown 笔记应用",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js",
    "diagnose:prerender": "electron scripts/editor-prerender-diagnostic.js",
    "test": "node --test test/*.test.js",
    "dist:mac": "npm run dist:mac:arm64 && npm run dist:mac:x64",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64"
  },
  "keywords": [
    "electron",
    "markdown",
    "note"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.47",
    "marked": "^11.0.0",
    "mermaid": "^11.16.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "build": {
    "appId": "com.simple-notes.app",
    "productName": "简记",
    "asar": true,
    "afterPack": "scripts/sign-macos-adhoc.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "image-directory.js",
      "hidden-directory.js",
      "note-path-security.js",
      "note-history.js",
      "note-history-diff.js",
      "renderer.js",
      "codemirror6-adapter.js",
      "editor-cursor.js",
      "editor-find.js",
      "editor-widget-height.js",
      "editor-pane-persistence.js",
      "markdown-keymap.js",
      "markdown-dialect.js",
      "markdown-structure.js",
      "slash-command-ui.js",
      "table-ui.js",
      "preview-task.js",
      "preview-markdown.js",
      "preview-security.js",
      "quick-open.js",
      "markdown-format.js",
      "clipboard-format.js",
      "index.html",
      "styles.css",
      "export-reading.css",
      "about.html",
      "about.css",
      "about.js",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "SimpleNote ${version}",
      "artifactName": "SimpleNote-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 420,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
